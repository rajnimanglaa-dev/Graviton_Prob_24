# Server
NODE_ENV=development
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fixmyarea
DB_USER=fixmyarea_app
DB_PASSWORD=replace-me

# Image storage: configure Cloudinary for public production image URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PUBLIC_API_URL=http://localhost:5000

# xAI Grok. grok-4.7 supports image input at the time this project was built.
XAI_API_KEY=
GROK_MODEL=grok-4.7

# OpenStreetMap routing and optional geocoding
OSRM_BASE_URL=http://router.project-osrm.org
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=FixMyArea/1.0 (contact@example.com)

# OR-Tools Python runtime. Install backend/requirements.txt before route optimization.
PYTHON_BIN=python

# SMS adapter
ALLOW_SMS_SIMULATOR=true
SMS_PROVIDER_WEBHOOK_SECRET=replace-me-before-enabling-a-real-provider
